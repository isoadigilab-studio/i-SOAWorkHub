# Copy to .env.local for local development. NEVER commit real values.
# Supabase -> Project Settings -> API (the anon key is public by design; security comes from RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public URL of the site (used in email verification / password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
