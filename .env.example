# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in Cloudflare -> Worker -> Settings -> Variables and secrets
# (NEXT_PUBLIC_* as variables for Build AND Runtime; the rest as SECRETS).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SITE_URL=https://isoa-workhub.isoa.workers.dev

# Invitation emails (Brevo HTTP API). MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=

# NOWPayments mass payouts (secrets only). Payouts need your NOWPayments dashboard email/password (JWT) and 2FA enabled.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
